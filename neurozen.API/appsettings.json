{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "TokenSettings": {
    "Issuer": "neurozen-api",
    "Audience": "neurozen-web",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "https://neurozen-web-frontend.vercel.app"
    ]
  },
  "PasswordReset": {
    "FrontendBaseUrl": "https://neurozen-web-frontend.vercel.app",
    "TokenLifetimeMinutes": 60,
    "MaxRequestsPerEmail": 3,
    "EmailWindowMinutes": 15
  },
  "Email": {
    "Port": 587,
    "EnableSsl": true,
    "From": "no-reply@neurozen.com",
    "FromName": "NeuroZen"
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "PasswordResetPermitLimit": 5,
    "PasswordResetWindowSeconds": 900
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "TrustAllProxies": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Swagger": {
    "Enabled": false
  }
}
